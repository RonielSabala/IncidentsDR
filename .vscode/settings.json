{
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "editor.formatOnSave": true,
  "cSpell.language": "en",
  "cSpell.caseSensitive": true,
  "markdown.extension.toc.levels": "2..3",
  "markdown.extension.toc.omittedFromToc": {
    "README.md": ["## Table of Contents"]
  },
  "[php]": {
    "editor.defaultFormatter": "junstyle.php-cs-fixer"
  },
  "php-cs-fixer.executablePath": "${workspaceFolder}/src/vendor/bin/php-cs-fixer",
  "php-cs-fixer.config": "src/.php-cs-fixer.php",
  "php-cs-fixer.allowRisky": true,
  "php-cs-fixer.formatHtml": true,
  "php-imports.formatOnSave": true,
  "php-imports.print.wrap.limit": 88,
  "php-imports.order": [
    "singleUses.class",
    "singleUses.function",
    "singleUses.const",
    "groupedUses.class",
    "groupedUses.function",
    "groupedUses.const"
  ],
  "phpNamespaceResolver.autoSort": true,
  "phpserver.port": 1111,
  "phpserver.relativePath": "src/public",
  "phpserver.autoOpenOnReload": false,
  "[sql]": {
    "editor.defaultFormatter": "inferrinizzard.prettier-sql-vscode"
  },
  "Prettier-SQL.SQLFlavourOverride": "mysql",
  "Prettier-SQL.keywordCase": "upper",
  "Prettier-SQL.expressionWidth": 88
}
